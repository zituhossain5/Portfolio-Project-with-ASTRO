---
import Header from "../components/layout/Header.astro";
import ClientLogos from "../components/sections/ClientLogos.astro";
import Contact from "../components/sections/Contact.astro";
import Hero from "../components/sections/Hero.astro";
import PortfolioMarquee from "../components/sections/PortfolioMarquee.astro";
import Portfolio from "../components/sections/Portfolio.astro";
import Process from "../components/sections/Process.astro";
import Services from "../components/sections/Services.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import WhyChoose from "../components/sections/WhyChoose.astro";
import { portfolio } from "../data/portfolio";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={portfolio.meta.title} description={portfolio.meta.description}>
	<Header />
	<main id="main-content">
		<div class="hero-showcase">
			<Hero />
			<PortfolioMarquee />
		</div>
		<ClientLogos />
		<WhyChoose />
		<Portfolio />
		<Services />
		<Testimonials />
		<Process />
		<Contact />
	</main>
</BaseLayout>

<style>
	/* Not a stacking context on purpose: the hero gradient blends with the page behind the cards and below them. */
	.hero-showcase {
		position: relative;
		overflow-x: clip;
		overflow-y: visible;
		background: var(--color-page);
	}
</style>
