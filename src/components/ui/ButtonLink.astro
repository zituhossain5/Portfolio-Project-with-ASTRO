---
import type { CtaLink } from "../../data/portfolio";

interface Props extends CtaLink {
	variant?: "primary" | "whatsapp";
	compact?: boolean;
	mobileLabel?: string;
	class?: string;
}

const { label, mobileLabel, href, icon, external, variant = "primary", compact = false, class: className } = Astro.props;
---

<a class:list={["button-link", `button-link--${variant}`, { "button-link--compact": compact }, className]} href={href} target={external ? "_blank" : undefined} rel={external ? "noopener noreferrer" : undefined}>
	<span class="button-link__rest">
		<img src={icon} alt="" aria-hidden="true" width={compact ? 20 : 24} height={compact ? 20 : 24} />
		<span class="button-link__label--desktop">{label}</span>
		<span class="button-link__label--mobile">{mobileLabel ?? label}</span>
	</span>
	{variant === "primary" && (
		<span class="action-pill__hover" aria-hidden="true">
			<span class="button-link__label--desktop">{label}</span>
			<span class="button-link__label--mobile">{mobileLabel ?? label}</span>
			<span class="action-pill__arrow"><img src="/icons/cta-arrow-up-right.svg" alt="" width="20" height="20" /></span>
		</span>
	)}
</a>
