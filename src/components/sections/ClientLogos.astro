---
import { portfolio } from "../../data/portfolio";

const { clients } = portfolio;
---

<section class="clients layout-rails" aria-label="Selected clients">
	<div class="layout-band" aria-hidden="true"></div>
	<ul class="content-container clients__grid" role="list">
		{clients.map(({ name, src, width, height, mobileHeight }) => (
			<li class="clients__tile">
				<img
					src={src}
					alt={name}
					width={width}
					height={height}
					loading="lazy"
					decoding="async"
					style={`--logo-height: ${height / 16}rem; --logo-height-mobile: ${mobileHeight / 16}rem;`}
				/>
			</li>
		))}
	</ul>
	<div class="layout-band" aria-hidden="true"></div>
</section>

<style>
	/* Figma "Section - Clients Logo" + "Layout Border 2": 462px tall from the bottom of the work marquee. */
	.clients {
		--layout-line: rgb(255 255 255 / 16%);
		position: relative;
		inset: auto;
		z-index: auto;
		display: flex;
		width: auto;
		height: auto;
		flex-direction: column;
		gap: 2.5rem;
		padding-top: 8.25rem;
		overflow: visible;
	}

	.clients__grid {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 0.625rem;
		margin-block: 0;
		padding: 0;
		list-style: none;
	}

	.clients__tile {
		display: grid;
		height: 5.75rem;
		place-items: center;
		border: 1px solid rgb(255 255 255 / 6%);
		border-radius: 0.75rem;
		/* Figma Noise: Mono, size 0.5, density 100%, white at 10%. */
		background: url("/images/surface-noise.png") 0 0 / 4rem 4rem repeat, #090c0f;
	}

	.clients__tile img {
		width: auto;
		max-width: calc(100% - 1.5rem);
		height: var(--logo-height);
		object-fit: contain;
	}

	@media (max-width: 72rem) {
		.clients__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}

	/* Figma mobile: 590px tall, 2-column 66px tiles. */
	@media (max-width: 56.24rem) {
		.clients {
			gap: 2rem;
			padding-top: 2rem;
		}

		.clients__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.clients__tile { height: 4.125rem; border-radius: 0.625rem; }
		.clients__tile img { height: var(--logo-height-mobile); }
	}
</style>
