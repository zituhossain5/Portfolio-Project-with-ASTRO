---
import { portfolio } from "../../data/portfolio";
import ButtonLink from "../ui/ButtonLink.astro";

const { selectedWorks } = portfolio;
---

<section class="portfolio-section layout-rails" id={selectedWorks.id} aria-labelledby="portfolio-heading">
	<div class="layout-band portfolio-section__band portfolio-section__band--top" aria-hidden="true"></div>

	<div class="content-container portfolio-section__inner">
		<div class="portfolio-section__main">
			<header class="portfolio-section__intro">
				<p class="portfolio-section__eyebrow"><span aria-hidden="true"></span>{selectedWorks.badge}</p>
				<h2 id="portfolio-heading">
					<span>{selectedWorks.heading}</span>
					<em>{selectedWorks.headingAccent}</em>
				</h2>
			</header>

			<ul class="portfolio-grid" role="list">
				{selectedWorks.projects.map(({ title, image, alt, tags }) => (
					<li class="project-card">
						<img
							class="project-card__image"
							src={image}
							alt={alt}
							width="660"
							height="460"
							loading="lazy"
							decoding="async"
						/>
						<div class="project-card__body">
							<div class="project-card__content">
								<h3>{title}</h3>
								<ul class="project-card__tags" aria-label="Project services">
									{tags.map((tag) => <li>{tag}</li>)}
								</ul>
							</div>
						</div>
					</li>
				))}
			</ul>
		</div>

		<div class="portfolio-section__actions">
			<button class="portfolio-section__more" type="button" disabled>{selectedWorks.viewMoreLabel}</button>
			<ButtonLink {...portfolio.hero.secondaryCta} variant="whatsapp" class="portfolio-section__chat" />
		</div>
	</div>

	<div class="layout-band portfolio-section__band portfolio-section__band--bottom" aria-hidden="true"></div>
</section>

<style>
	.portfolio-section {
		padding-block: 9.25rem 5.5rem;
		background: var(--color-page);
	}

	.portfolio-section__band {
		position: absolute;
		right: 0;
		left: 0;
	}

	.portfolio-section__band--top { top: 3.75rem; }
	.portfolio-section__band--bottom { bottom: 0; }

	.portfolio-section__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3.75rem;
	}

	.portfolio-section__main {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: 3.75rem;
	}

	.portfolio-section__intro {
		width: min(57.25rem, 100%);
		text-align: center;
	}

	.portfolio-section__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		margin: 0 0 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.portfolio-section__eyebrow span {
		width: 0.75rem;
		height: 0.75rem;
		flex: 0 0 auto;
		border-radius: 0.125rem;
		background: var(--color-brand);
	}

	.portfolio-section h2 {
		margin: 0;
		font-size: 4.5rem;
		line-height: 1.1;
	}

	.portfolio-section h2 span,
	.portfolio-section h2 em { display: block; }

	.portfolio-section h2 span {
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	.portfolio-section h2 em {
		font-family: "Instrument Serif", Georgia, serif;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.portfolio-grid {
		display: grid;
		width: 100%;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem;
		border-radius: 1.25rem;
		background: rgb(255 255 255 / 10%);
		box-shadow: inset 0 0 0 1px var(--color-border-subtle);
	}

	.project-card__image {
		width: 100%;
		aspect-ratio: 2000 / 1393;
		border-radius: 0.875rem;
		object-fit: cover;
	}

	.project-card__body {
		display: flex;
		min-width: 0;
		min-height: 6.875rem;
		align-items: center;
		padding: 1.25rem 0.75rem;
	}

	.project-card__content {
		display: flex;
		min-width: 0;
		width: 100%;
		flex-direction: column;
		gap: 1rem;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-card__tags li {
		border-radius: var(--radius-pill);
		background: rgb(255 255 255 / 8%);
		padding: 0.25rem 0.625rem;
		color: var(--color-text-80);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.3;
		white-space: nowrap;
	}

	.portfolio-section__actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.portfolio-section__more {
		height: 3.25rem;
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--color-text);
		padding: 0.9375rem 1.25rem;
		color: var(--color-ink);
		font: inherit;
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.22;
		white-space: nowrap;
	}

	.portfolio-section__more:disabled {
		cursor: not-allowed;
		opacity: 1;
	}

	.portfolio-section__actions :global(.portfolio-section__chat) {
		height: 3.25rem;
		gap: 0.625rem;
		padding-block: 0.375rem;
	}

	@media (max-width: 72rem) {
		.project-card h3 { font-size: 1.25rem; }
		.project-card__body { align-items: flex-start; }
	}

	@media (max-width: 56.24rem) {
		.portfolio-section {
			padding-block: 6.5rem 4rem;
		}

		.portfolio-section__band--top { top: 2.5rem; }
		.portfolio-section__inner { gap: 2.5rem; }
		.portfolio-section__main { gap: 2rem; }
		.portfolio-section__intro { width: 100%; }

		.portfolio-section h2 {
			font-size: 2.5rem;
			line-height: 1.1;
		}

		.portfolio-section h2 span,
		.portfolio-section h2 em { letter-spacing: -0.01em; }

		.portfolio-section h2 span { font-weight: 600; }

		.portfolio-grid { grid-template-columns: minmax(0, 1fr); }
		.project-card__body { min-height: 0; padding-block: 1rem; }
		.project-card__content { gap: 0.75rem; }
		.portfolio-section__actions { flex-wrap: wrap; }
	}

	@media (min-width: 40rem) and (max-width: 56.24rem) {
		.portfolio-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 25rem) {
		.portfolio-section__actions {
			width: 100%;
			flex-direction: column;
		}

		.portfolio-section__more,
		.portfolio-section__actions :global(.portfolio-section__chat) { width: 100%; }
	}
</style>
