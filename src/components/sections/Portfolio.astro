---
import { portfolio, type PortfolioProject } from "../../data/portfolio";
import { getCollection } from "astro:content";
import ButtonLink from "../ui/ButtonLink.astro";

interface Props {
	variant?: "home" | "works";
}

const { variant = "home" } = Astro.props;
const { selectedWorks } = portfolio;
const isWorksPage = variant === "works";
const projects: PortfolioProject[] = isWorksPage
	? [...selectedWorks.projects, ...selectedWorks.worksOnlyProjects]
	: selectedWorks.projects;
const workSlugs = new Set((await getCollection("works")).map((entry) => entry.id));
---

<section
	class:list={["portfolio-section layout-rails", { "portfolio-section--works": isWorksPage }]}
	id={selectedWorks.id}
	aria-labelledby={isWorksPage ? undefined : "portfolio-heading"}
	aria-label={isWorksPage ? "Selected work" : undefined}
>
	<div class="layout-band portfolio-section__band portfolio-section__band--top" aria-hidden="true"></div>

	<div class="content-container portfolio-section__inner">
		<div class="portfolio-section__main">
			{!isWorksPage && (
				<header class="portfolio-section__intro">
					<p class="portfolio-section__eyebrow"><span aria-hidden="true"></span>{selectedWorks.badge}</p>
					<h2 id="portfolio-heading">
						<span>{selectedWorks.heading}</span>
						<em>{selectedWorks.headingAccent}</em>
					</h2>
				</header>
			)}

			<ul class="portfolio-grid" role="list">
				{projects.map(({ title, image, alt, tags, slug }) => {
					const href = slug && workSlugs.has(slug) ? `/works/${slug}` : undefined;
					const CardSurface = href ? "a" : "div";
					return (
						<li class:list={["project-card", { "project-card--linked": href }]}>
							<CardSurface class="project-card__surface" href={href} aria-label={href ? `View project: ${title}` : undefined}>
								<div class="project-card__media" data-project-media={href ? "" : undefined}>
									<img
										class="project-card__image"
										src={image}
										alt={alt}
										width="660"
										height="460"
										loading="lazy"
										decoding="async"
									/>
									{href && (
										<span class="project-card__cta" aria-hidden="true">
											<span class="project-card__cta-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
											<span>View Project</span>
										</span>
									)}
								</div>
								<div class="project-card__body">
									<div class="project-card__content">
										<h3>{title}</h3>
										<ul class="project-card__tags" aria-label="Project services">
											{tags.map((tag) => <li>{tag}</li>)}
										</ul>
									</div>
								</div>
							</CardSurface>
						</li>
					);
				})}
			</ul>
		</div>

		{!isWorksPage && (
			<div class="portfolio-section__actions">
				<a class="portfolio-section__more action-pill--light" href="/works">
					<span class="action-pill__rest">{selectedWorks.viewMoreLabel}</span>
					<span class="action-pill__hover" aria-hidden="true">
						<span>{selectedWorks.viewMoreLabel}</span>
						<span class="action-pill__arrow"><img src="/icons/cta-arrow-up-right.svg" alt="" width="20" height="20" /></span>
					</span>
				</a>
				<ButtonLink {...portfolio.hero.secondaryCta} variant="whatsapp" class="portfolio-section__chat" />
			</div>
		)}
	</div>

	<div class="layout-band portfolio-section__band portfolio-section__band--bottom" aria-hidden="true"></div>
</section>

<script>
	const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
	const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
	const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);

	for (const media of document.querySelectorAll<HTMLElement>("[data-project-media]")) {
		const cta = media.querySelector<HTMLElement>(".project-card__cta");
		const card = media.closest<HTMLAnchorElement>("a.project-card__surface");
		if (!cta) continue;

		let bounds: DOMRect;
		let badgeWidth = 0;
		let badgeHeight = 0;
		let currentX = 0;
		let currentY = 0;
		let targetX = 0;
		let targetY = 0;
		let frame = 0;
		let resetTimer = 0;
		let active = false;

		const updateTarget = (event: PointerEvent) => {
			const pointerX = event.clientX - bounds.left;
			const pointerY = event.clientY - bounds.top;
			const halfWidth = badgeWidth / 2;
			const halfHeight = badgeHeight / 2;
			const inset = 12;
			const gap = 14;
			const minX = halfWidth + inset;
			const maxX = Math.max(minX, bounds.width - halfWidth - inset);
			const minY = halfHeight + inset;
			const maxY = Math.max(minY, bounds.height - halfHeight - inset);
			const right = pointerX + gap + halfWidth;
			const left = pointerX - gap - halfWidth;
			const below = pointerY + gap + halfHeight;
			const above = pointerY - gap - halfHeight;

			targetX = clamp(right <= maxX ? right : left >= minX ? left : pointerX, minX, maxX);
			targetY = clamp(below <= maxY ? below : above >= minY ? above : pointerY, minY, maxY);
		};

		const positionBadge = () => {
			cta.style.transform = `translate3d(${currentX - bounds.width / 2}px, ${currentY - bounds.height / 2}px, 0) translate(-50%, -50%)`;
		};

		const animate = () => {
			if (!active) { frame = 0; return; }
			const easing = reducedMotion.matches ? 1 : 0.22;
			currentX += (targetX - currentX) * easing;
			currentY += (targetY - currentY) * easing;
			if (Math.abs(targetX - currentX) < 0.25 && Math.abs(targetY - currentY) < 0.25) {
				currentX = targetX;
				currentY = targetY;
				positionBadge();
				frame = 0;
				return;
			}
			positionBadge();
			frame = requestAnimationFrame(animate);
		};

		const stopTracking = (resetImmediately = false) => {
			active = false;
			media.classList.remove("is-pointer-active");
			cancelAnimationFrame(frame);
			frame = 0;
			window.clearTimeout(resetTimer);
			if (resetImmediately) {
				cta.style.removeProperty("transform");
			} else {
				resetTimer = window.setTimeout(() => {
					if (!active) cta.style.removeProperty("transform");
				}, 220);
			}
		};

		media.addEventListener("pointerenter", (event) => {
			if (!finePointer.matches || event.pointerType !== "mouse" || card?.matches(":focus-visible")) return;
			window.clearTimeout(resetTimer);
			bounds = media.getBoundingClientRect();
			badgeWidth = cta.offsetWidth;
			badgeHeight = cta.offsetHeight;
			updateTarget(event);
			currentX = targetX;
			currentY = targetY;
			positionBadge();
			active = true;
			media.classList.add("is-pointer-active");
		});

		media.addEventListener("pointermove", (event) => {
			if (!active) return;
			updateTarget(event);
			if (!frame) frame = requestAnimationFrame(animate);
		});

		media.addEventListener("pointerleave", () => stopTracking());
		card?.addEventListener("focusin", () => stopTracking(true));
		window.addEventListener("resize", () => stopTracking(true));
	}
</script>

<style>
	.portfolio-section {
		padding-block: 9.25rem 5.5rem;
		background: var(--color-page);
	}

	.portfolio-section--works {
		padding-block: 10.0625rem 5.527rem;
	}

	.portfolio-section--works .portfolio-section__band--top { top: 4.5625rem; }
	.portfolio-section--works .portfolio-section__inner,
	.portfolio-section--works .portfolio-section__main { gap: 0; }

	.portfolio-section__band {
		position: absolute;
		right: 0;
		left: 0;
	}

	.portfolio-section__band--top { top: 3.75rem; }
	.portfolio-section__band--bottom { bottom: 0; }

	.portfolio-section__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3.75rem;
	}

	.portfolio-section__main {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: 3.75rem;
	}

	.portfolio-section__intro {
		width: min(57.25rem, 100%);
		text-align: center;
	}

	.portfolio-section__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		margin: 0 0 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.portfolio-section__eyebrow span {
		width: 0.75rem;
		height: 0.75rem;
		flex: 0 0 auto;
		border-radius: 0.125rem;
		background: var(--color-brand);
	}

	.portfolio-section h2 {
		margin: 0;
		font-size: 4.5rem;
		line-height: 1.1;
	}

	.portfolio-section h2 span,
	.portfolio-section h2 em { display: block; }

	.portfolio-section h2 span {
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	.portfolio-section h2 em {
		font-family: "Instrument Serif", Georgia, serif;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.portfolio-grid {
		display: grid;
		width: 100%;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-card {
		position: relative;
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.75rem;
		border-radius: 1.25rem;
		background: rgb(255 255 255 / 10%);
		box-shadow: inset 0 0 0 1px var(--color-border-subtle);
	}

	.project-card__surface {
		display: flex;
		min-width: 0;
		width: 100%;
		flex: 1;
		flex-direction: column;
		gap: 0.25rem;
		border-radius: inherit;
	}

	.project-card__surface:focus-visible {
		outline: 2px solid var(--color-brand);
		outline-offset: 4px;
	}

	.project-card__media {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 2000 / 1393;
		overflow: hidden;
		border-radius: 0.875rem;
	}

	.project-card__media::after {
		position: absolute;
		inset: 0;
		background: rgb(0 0 0 / 50%);
		content: "";
		opacity: 0;
		pointer-events: none;
		transition: opacity 320ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-card__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border-radius: 0.875rem;
		object-fit: cover;
		transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.project-card__cta {
		position: absolute;
		top: 50%;
		left: 50%;
		z-index: 1;
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		gap: 0.5rem;
		border: 1px solid rgb(255 255 255 / 65%);
		border-radius: 0.75rem;
		background: rgb(255 255 255 / 78%);
		box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 20%);
		color: var(--color-ink);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.2;
		opacity: 0;
		padding: 0.25rem 0.875rem 0.25rem 0.25rem;
		pointer-events: none;
		transform: translate3d(0, 0, 0) translate(-50%, -50%);
		transition: opacity 220ms ease;
		white-space: nowrap;
		backdrop-filter: blur(12px);
	}

	.project-card__cta-icon {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 0.5rem;
		background: rgb(255 255 255 / 85%);
		box-shadow: 0 0.125rem 0.375rem rgb(0 0 0 / 15%);
	}

	.project-card__surface:focus-visible .project-card__media::after,
	.project-card__surface:focus-visible .project-card__cta { opacity: 1; }

	@media (hover: hover) and (pointer: fine) {
		.project-card__media.is-pointer-active,
		.project-card__media.is-pointer-active * { cursor: none; }

		.project-card__surface:hover .project-card__image { transform: scale(1.05); }

		.project-card__surface:hover .project-card__media::after,
		.project-card__media.is-pointer-active .project-card__cta { opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.project-card__media::after,
		.project-card__image,
		.project-card__cta { transition: none; }
	}

	.project-card__body {
		display: flex;
		min-width: 0;
		min-height: 6.875rem;
		align-items: center;
		padding: 1.25rem 0.75rem;
	}

	.project-card__content {
		display: flex;
		min-width: 0;
		width: 100%;
		flex-direction: column;
		gap: 1rem;
	}

	.project-card h3 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.project-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-card__tags li {
		border-radius: var(--radius-pill);
		background: rgb(255 255 255 / 8%);
		padding: 0.25rem 0.625rem;
		color: var(--color-text-80);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.3;
		white-space: nowrap;
	}

	.portfolio-section__actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
	}

	.portfolio-section__actions :global(.portfolio-section__chat) {
		height: 3.25rem;
		gap: 0.625rem;
		padding-block: 0.375rem;
	}

	@media (max-width: 72rem) {
		.project-card h3 { font-size: 1.25rem; }
		.project-card__body { align-items: flex-start; }
	}

	@media (max-width: 56.24rem) {
		.portfolio-section {
			padding-block: 6.5rem 4rem;
		}

		.portfolio-section__band--top { top: 2.5rem; }
		.portfolio-section--works { padding-block: 6.5rem 4.094rem; }
		.portfolio-section--works .portfolio-section__band--top { top: 2.5rem; }
		.portfolio-section__inner { gap: 2.5rem; }
		.portfolio-section__main { gap: 2rem; }
		.portfolio-section__intro { width: 100%; }

		.portfolio-section h2 {
			font-size: 2.5rem;
			line-height: 1.1;
		}

		.portfolio-section h2 span,
		.portfolio-section h2 em { letter-spacing: -0.01em; }

		.portfolio-section h2 span { font-weight: 600; }

		.portfolio-grid { grid-template-columns: minmax(0, 1fr); }
		.project-card__body { min-height: 0; padding-block: 1rem; }
		.project-card__content { gap: 0.75rem; }
		.portfolio-section--works .project-card__body {
			min-height: 9.5rem;
			padding: 0.75rem 0.5rem;
		}
		.portfolio-section--works .project-card__content { gap: 1rem; }
		.portfolio-section__actions { flex-wrap: wrap; }
	}

	@media (min-width: 40rem) and (max-width: 56.24rem) {
		.portfolio-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}

	@media (max-width: 25rem) {
		.portfolio-section__actions {
			width: 100%;
			flex-direction: column;
		}

		.portfolio-section__more,
		.portfolio-section__actions :global(.portfolio-section__chat) { width: 100%; }
	}
</style>
