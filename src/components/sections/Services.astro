---
import { portfolio } from "../../data/portfolio";

const { services } = portfolio;
---

<section class="services layout-rails" id={services.id} aria-labelledby="services-heading">
	<div class="layout-band services__band services__band--top" aria-hidden="true"></div>

	<div class="content-container services__inner">
		<header class="services__intro">
			<div class="services__headline">
				<p class="services__eyebrow"><span aria-hidden="true"></span>{services.badge}</p>
				<h2 id="services-heading">
					<span>{services.heading}</span>
					<em>{services.headingAccent}</em>
				</h2>
			</div>
			<p class="services__description">{services.description}</p>
		</header>

		<div class="services__cards">
			{services.cards.map(({ title, titleLines, description, items, icon }) => (
				<article class="service-card">
					<div class="service-card__icon" aria-hidden="true">
						<img src={icon} alt="" width="52" height="52" decoding="async" />
					</div>
					<div class="service-card__content">
						<h3 aria-label={title}>
							{titleLines ? titleLines.map((line) => <span aria-hidden="true">{line}</span>) : title}
						</h3>
						<div class="service-card__details">
							<p>{description}</p>
							<ul>
								{items.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</div>
				</article>
			))}
		</div>
	</div>

	<div class="layout-band services__band services__band--bottom" aria-hidden="true"></div>
</section>

<style>
	.services {
		padding-block: 9.25rem 5.5rem;
		background: var(--color-page);
	}

	.services__band {
		position: absolute;
		right: 0;
		left: 0;
	}

	.services__band--top { top: 3.75rem; }
	.services__band--bottom { bottom: 0; }

	.services__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3.75rem;
	}

	.services__intro {
		display: flex;
		width: min(55.875rem, 100%);
		min-height: 16.5625rem;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
		text-align: center;
	}

	.services__headline {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.services__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.services__eyebrow span {
		width: 0.75rem;
		height: 0.75rem;
		flex: 0 0 auto;
		border-radius: 0.125rem;
		background: var(--color-brand);
	}

	.services h2 {
		margin: 0;
		font-size: 4.5rem;
		line-height: 1.1;
	}

	.services h2 span,
	.services h2 em { display: block; }

	.services h2 span {
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	.services h2 em {
		font-family: "Instrument Serif", Georgia, serif;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.services__description {
		width: min(38.625rem, 100%);
		margin: 0;
		color: var(--color-text-muted);
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.services__cards {
		position: relative;
		display: grid;
		width: 100%;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.75rem;
		padding: 0.75rem;
		overflow: hidden;
		border-radius: 1.25rem;
		background: #090c0f;
		box-shadow: inset 0 0 0 1px var(--color-border-subtle);
		isolation: isolate;
	}

	/* Same panel grain as "Why work with me" (see the note there), under the cards so it never dims text or icons. */
	.services__cards::after {
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: inherit;
		background: image-set(url("/images/card-grain.png") 1x, url("/images/card-grain@2x.png") 2x) 0 0 / 8rem 8rem repeat;
		content: "";
		pointer-events: none;
	}

	.service-card {
		position: relative;
		display: flex;
		min-width: 0;
		min-height: 31.125rem;
		flex-direction: column;
		gap: 2rem;
		padding: 1.5rem;
		border-radius: 0.875rem;
		background: rgb(255 255 255 / 6%);
		box-shadow: inset 0 0 0 1px var(--color-border-subtle);
	}

	.service-card > * {
		position: relative;
		z-index: 1;
	}

	.service-card__icon {
		display: grid;
		width: 4.75rem;
		height: 4.75rem;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 0.75rem;
		background: rgb(255 255 255 / 6%);
		box-shadow: inset 0 0 0 1px var(--color-border-subtle);
	}

	.service-card__icon img {
		width: 3.25rem;
		height: 3.25rem;
	}

	.service-card__content {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 1.5rem;
	}

	.service-card h3 {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.15;
	}

	.service-card h3 span { display: block; }

	.service-card__details {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		color: var(--color-text-muted);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.6;
	}

	.service-card__details p,
	.service-card__details ul { margin: 0; }

	.service-card__details ul {
		padding-left: 1.5rem;
		list-style: disc;
	}

	@media (max-width: 79.99rem) {
		.services__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.service-card { min-height: 31.125rem; }
	}

	@media (max-width: 56.24rem) {
		.services { padding-block: 6.5rem 4rem; }
		.services__band--top { top: 2.5rem; }
		.services__inner { gap: 2rem; }
		.services__intro { width: 100%; min-height: 0; }

		.services h2 {
			font-size: 2.5rem;
			line-height: 1.1;
		}

		.services h2 span,
		.services h2 em { letter-spacing: -0.01em; }

		.services h2 span { font-weight: 600; }

		.services__description {
			font-size: 1rem;
			line-height: 1.6;
		}

		.service-card {
			min-height: 0;
			gap: 1.5rem;
			padding: 1rem 1rem 1.5rem;
		}

		.service-card__content { gap: 1.25rem; }
		.service-card h3 { font-size: 1.5rem; line-height: 1.2; }
	}

	@media (max-width: 39.99rem) {
		.services__cards { grid-template-columns: minmax(0, 1fr); }
	}
</style>
