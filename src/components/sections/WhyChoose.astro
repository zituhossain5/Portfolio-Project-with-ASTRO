---
import { portfolio } from "../../data/portfolio";

const { whyChoose } = portfolio;
---

<section class="why" id={whyChoose.id} aria-labelledby="why-heading">
	<div class="why__band why__band--top" aria-hidden="true"></div>

	<div class="content-container why__inner">
		<header class="why__intro">
			<div class="why__headline">
				<p class="why__eyebrow"><span aria-hidden="true"></span>{whyChoose.badge}</p>
				<h2 id="why-heading">
					<span>{whyChoose.heading}</span>
					<em>{whyChoose.headingAccent}</em>
				</h2>
			</div>
			<p class="why__description">{whyChoose.description}</p>
		</header>

		<div class="why__cards">
			<article class="why__card why__featured">
				<div class="why__icon-shell" aria-hidden="true">
					<img src={whyChoose.featured.icon} alt="" width="40" height="40" />
				</div>
				<div class="why__copy why__featured-copy">
					<h3>{whyChoose.featured.title}</h3>
					{whyChoose.featured.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
				</div>
			</article>

			<div class="why__stats" aria-label="Experience at a glance">
				{whyChoose.stats.map(({ value, label }) => (
					<div class="why__stat">
						<strong>{value}</strong>
						<span>{label}</span>
					</div>
				))}
			</div>

			{whyChoose.principles.map(({ title, description, icon }) => (
				<article class="why__card why__principle">
					<div class="why__icon-shell" aria-hidden="true">
						<img src={icon} alt="" width="40" height="40" loading="lazy" decoding="async" />
					</div>
					<div class="why__copy">
						<h3>{title}</h3>
						<p>{description}</p>
					</div>
				</article>
			))}
		</div>
	</div>

	<div class="why__band why__band--bottom" aria-hidden="true"></div>
</section>

<style>
	.why {
		--rail-line: rgb(255 255 255 / 15%);
		--dash-x: repeating-linear-gradient(to right, var(--rail-line) 0 3px, transparent 3px 5px);
		--dash-y: repeating-linear-gradient(to bottom, var(--rail-line) 0 3px, transparent 3px 5px);
		--rails-inset: calc(50% - var(--container-rails) / 2);
		position: relative;
		padding-block: 9.25rem 5.5rem;
		background: var(--color-page);
	}

	.why::before,
	.why::after {
		position: absolute;
		top: 0;
		bottom: 0;
		z-index: 0;
		width: 1px;
		background: var(--dash-y);
		content: "";
		pointer-events: none;
	}

	.why::before { left: var(--rails-inset); }
	.why::after { right: var(--rails-inset); }

	.why__band {
		position: absolute;
		left: var(--rails-inset);
		right: var(--rails-inset);
		height: 1.75rem;
		background:
			var(--dash-x) top / 100% 1px no-repeat,
			var(--dash-x) bottom / 100% 1px no-repeat,
			url("/images/why-layout-hatch.png") center / 100% 100% no-repeat;
		pointer-events: none;
	}

	.why__band--top { top: 3.75rem; }
	.why__band--bottom { bottom: 0; }

	.why__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		gap: 3.75rem;
	}

	.why__intro {
		width: min(55.875rem, 100%);
		margin-inline: auto;
		text-align: center;
	}

	.why__headline { height: 11.6875rem; }

	.why__eyebrow {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.625rem;
		margin: 0 0 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.why__eyebrow span {
		width: 0.75rem;
		height: 0.75rem;
		flex: 0 0 auto;
		border-radius: 0.125rem;
		background: var(--color-brand);
	}

	.why h2 {
		margin: 0;
		font-size: 4.5rem;
		line-height: 1.1;
	}

	.why h2 span,
	.why h2 em { display: block; }

	.why h2 span {
		font-weight: 700;
		letter-spacing: -0.04em;
	}

	.why h2 em {
		font-family: "Instrument Serif", Georgia, serif;
		font-weight: 400;
		letter-spacing: -0.03em;
	}

	.why__description {
		width: min(46.75rem, 100%);
		margin: 1.25rem auto 0;
		color: var(--color-text-muted);
		font-size: 1.125rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.why__cards {
		position: relative;
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		grid-template-rows: 21.375rem 21.25rem 21.25rem;
		gap: 0.75rem;
		height: 66.875rem;
		padding: 0.75rem;
		overflow: hidden;
		border: 1px solid var(--color-border-subtle);
		border-radius: 1.25rem;
		background: #090c0f;
	}

	.why__cards::after,
	.why__stat::after {
		position: absolute;
		inset: 0;
		z-index: 2;
		border-radius: inherit;
		background: url("/images/why-card-noise.svg") 0 0 / 2rem 2rem repeat;
		content: "";
		pointer-events: none;
	}

	.why__card,
	.why__stat {
		position: relative;
		min-width: 0;
		border: 1px solid var(--color-border-subtle);
		border-radius: 0.875rem;
		background: rgb(255 255 255 / 6%);
	}

	.why__card > *,
	.why__stat > * {
		position: relative;
		z-index: 1;
	}

	.why__featured {
		display: flex;
		grid-column: 1 / 4;
		grid-row: 1;
		flex-direction: column;
		padding: 1.5rem;
	}

	.why__stats {
		display: grid;
		min-width: 0;
		grid-column: 4 / 7;
		grid-row: 1;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(2, 10.3125rem);
		gap: 0.75rem;
	}

	.why__stat {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.5rem;
		padding: 2.5rem;
	}

	.why__stat:first-child { grid-column: 1 / -1; }

	.why__stat strong {
		font-size: 3rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.1;
	}

	.why__stat span {
		color: var(--color-text-muted);
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.22;
	}

	.why__principle {
		display: flex;
		grid-column: span 2;
		flex-direction: column;
		padding: 1.5rem;
	}

	.why__icon-shell {
		display: grid;
		width: 4rem;
		height: 4rem;
		flex: 0 0 auto;
		place-items: center;
		border: 1px solid var(--color-border-subtle);
		border-radius: 0.75rem;
		background: rgb(255 255 255 / 6%);
	}

	.why__icon-shell img {
		width: 2.5rem;
		height: 2.5rem;
	}

	.why__copy {
		min-width: 0;
		margin-top: auto;
	}

	.why__copy h3 {
		margin: 0;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.why__copy p {
		margin: 0.75rem 0 0;
		color: var(--color-text-muted);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.6;
	}

	.why__featured-copy p { margin-top: 0.5rem; }

	@media (max-width: 79.99rem) and (min-width: 56.25rem) {
		.why { padding-block: 7.5rem 5rem; }
		.why__band--top { top: 3rem; }

		.why__cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: auto;
			height: auto;
		}

		.why__featured,
		.why__stats {
			grid-column: 1 / -1;
			grid-row: auto;
		}

		.why__featured { min-height: 21.375rem; }
		.why__stats { min-height: 21.375rem; }
		.why__principle { grid-column: span 1; min-height: 21.25rem; }
	}

	@media (max-width: 56.24rem) {
		.why {
			--rails-inset: 0.5rem;
			padding-block: 6.5rem 4rem;
		}

		.why__band { height: 1.5rem; }
		.why__band--top { top: 2.5rem; }

		.why__inner { gap: 2rem; }
		.why__intro { width: 100%; }
		.why__headline { height: 7.25rem; }
		.why__eyebrow { margin-bottom: 0.75rem; }

		.why h2 {
			font-size: 2.5rem;
			line-height: 1.1;
		}

		.why h2 span,
		.why h2 em { letter-spacing: -0.01em; }

		.why h2 span { font-weight: 600; }

		.why__description {
			margin-top: 1.25rem;
			font-size: 1rem;
			line-height: 1.6;
		}

		.why__cards {
			display: flex;
			height: auto;
			flex-direction: column;
			gap: 0.75rem;
		}

		.why__featured { min-height: 26.125rem; order: 2; padding: 1rem; }
		.why__stats { min-height: 17rem; order: 1; }
		.why__principle { min-height: 17.3125rem; order: 3; padding: 1rem; }
		.why__principle:nth-of-type(6) { min-height: 19.125rem; }

		.why__stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: 7.5rem 8.75rem;
		}

		.why__stat {
			justify-content: flex-start;
			padding: 1.5rem 1.25rem;
		}

		.why__stat strong { font-size: 2.5rem; }

		.why__featured-copy { margin-top: 1.5rem; }
		.why__featured-copy p { margin-top: 0.75rem; }
		.why__principle .why__copy { margin-top: 1.5rem; }
		.why__principle .why__copy p { margin-top: 1rem; }
	}

	@media (min-width: 40rem) and (max-width: 56.24rem) {
		.why__cards {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.why__stats,
		.why__featured {
			grid-column: 1 / -1;
			grid-row: auto;
		}
		.why__featured { min-height: 21.375rem; }
		.why__principle { grid-column: span 1; }
	}
</style>
