---
import ButtonLink from "../ui/ButtonLink.astro";
import { calendlyBookingUrl, portfolio } from "../../data/portfolio";

const onHomePage = Astro.url.pathname === "/";
const resolveHref = (href: string) => href.startsWith("#") && !onHomePage ? `/${href}` : href;
const bookCall = { label: "Book a Call", href: calendlyBookingUrl, icon: "/icons/calendar.svg" as const, external: true };
---

<header class="site-header">
	<nav class="desktop-nav" aria-label="Primary navigation">
		<div class="desktop-nav__left">
			<a class="brand-link" href={onHomePage ? "#top" : "/"} aria-label="Abdur Rahim — home">
				<img src="/icons/logo.svg" alt="Abdur Rahim" width="82" height="36" />
			</a>
			<ul class="desktop-nav__links">
				{portfolio.navigation.map((item) => <li><a href={resolveHref(item.href)}>{item.label}</a></li>)}
			</ul>
		</div>
		<div class="desktop-nav__right">
			<p class="availability">
				<span class="availability__status" aria-hidden="true">
					<img src="/icons/availability.svg" alt="" width="18" height="18" />
				</span>
				<span>{portfolio.availability}</span>
			</p>
			<ButtonLink {...bookCall} compact />
		</div>
	</nav>

	<a class="mobile-brand-link" href="/" aria-label="Abdur Rahim — home">
		<img class="mobile-nav__logo" src="/icons/logo.svg" alt="" width="68" height="30" />
	</a>
	<details class="mobile-nav">
		<summary aria-label="Toggle navigation menu">
			<img class="mobile-nav__menu" src="/icons/menu.svg" alt="" aria-hidden="true" width="24" height="24" />
			<img class="mobile-nav__close" src="/icons/close.svg" alt="" aria-hidden="true" width="24" height="24" />
		</summary>
		<div class="mobile-nav__panel">
			<ul>
				{portfolio.navigation.map((item) => <li><a href={resolveHref(item.href)}>{item.label}</a></li>)}
			</ul>
			<ButtonLink {...bookCall} compact class="mobile-nav__cta" />
		</div>
	</details>
</header>

<script>
	const header = document.querySelector<HTMLElement>(".site-header");
	const mobileMenu = header?.querySelector<HTMLDetailsElement>(".mobile-nav");

	if (header) {
		let lastScrollY = Math.max(0, window.scrollY);
		let frame: number | null = null;
		const topThreshold = header.offsetHeight + parseFloat(getComputedStyle(header).top);

		const updateVisibility = () => {
			const scrollY = Math.max(0, window.scrollY);
			const distance = scrollY - lastScrollY;

			if (scrollY <= topThreshold || mobileMenu?.open) {
				header.classList.remove("site-header--hidden");
				lastScrollY = scrollY;
			} else if (Math.abs(distance) >= 4) {
				header.classList.toggle("site-header--hidden", distance > 0);
				lastScrollY = scrollY;
			}

			frame = null;
		};

		window.addEventListener("scroll", () => {
			if (frame === null) frame = requestAnimationFrame(updateVisibility);
		}, { passive: true });
		mobileMenu?.addEventListener("toggle", () => {
			if (mobileMenu.open) header.classList.remove("site-header--hidden");
			lastScrollY = Math.max(0, window.scrollY);
		});
		header.addEventListener("focusin", () => header.classList.remove("site-header--hidden"));
	}
</script>

<style>
	.site-header { --header-translate-y: 0px; position: fixed; top: 0.75rem; left: 50%; z-index: 30; width: min(var(--container-content), calc(100% - 2.5rem)); transform: translate3d(-50%, var(--header-translate-y), 0); transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1); will-change: transform; }
	.site-header--hidden { --header-translate-y: calc(-100% - 1.25rem); pointer-events: none; }
	.desktop-nav, .mobile-nav { border: 1px solid var(--color-border); background: rgb(0 0 0 / 2%); backdrop-filter: blur(40px); }
	.desktop-nav { display: flex; height: 4.25rem; align-items: center; justify-content: space-between; border-radius: var(--radius-pill); padding: 0.75rem 0.75rem 0.75rem 2rem; }
	.desktop-nav__left, .desktop-nav__right, .desktop-nav__links, .availability { display: flex; align-items: center; }
	.desktop-nav__left { gap: 4.25rem; }
	.brand-link { flex: none; }
	.desktop-nav__links { gap: 1.5rem; margin: 0; padding: 0; list-style: none; color: var(--color-text-80); font-size: 1rem; font-weight: 600; line-height: 1.22; }
	.desktop-nav__links a { display: block; padding-block: 0.75rem; }
	.desktop-nav__links a:hover { color: var(--color-text); }
	.desktop-nav__right { gap: 1.5rem; }
	.availability { gap: 1rem; margin: 0; color: var(--color-text-muted); font-size: 0.875rem; font-weight: 500; line-height: 1.5; white-space: nowrap; }
	.availability__status { position: relative; display: block; width: 1.125rem; height: 1.125rem; flex: none; }
	.availability__status img { position: relative; z-index: 1; }
	.availability__status::after {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: #14dd4a;
		content: "";
		opacity: 0;
		pointer-events: none;
		animation: availability-pulse 1.9s ease-out infinite;
	}
	@keyframes availability-pulse {
		0% { transform: scale(0.65); opacity: 0.2; }
		100% { transform: scale(1.65); opacity: 0; }
	}
	.mobile-brand-link { display: none; position: absolute; top: 0.9375rem; left: 1.25rem; z-index: 1; }
	.mobile-nav { display: none; overflow: hidden; border-radius: var(--radius-pill); }
	.mobile-nav summary { display: flex; width: 3.75rem; height: 3.75rem; cursor: pointer; align-items: center; justify-content: center; margin-left: auto; list-style: none; }
	.mobile-nav summary::-webkit-details-marker { display: none; }
	.mobile-nav__logo { width: 4.2575rem; height: 1.875rem; }
	.mobile-nav__close { display: none; }
	.mobile-nav__panel { display: flex; flex-direction: column; gap: 1rem; padding: 0 1.25rem 1.25rem; }
	.mobile-nav__panel ul { display: flex; flex-direction: column; gap: 1.25rem; margin: 0; padding: 0.75rem 0; list-style: none; color: var(--color-text-80); font-size: 1rem; font-weight: 600; line-height: 1.22; }
	.mobile-nav__panel a:not(.mobile-nav__cta) { display: block; }
	.mobile-nav :global(.mobile-nav__cta) { width: 100%; }
	.mobile-nav[open] { border-radius: var(--radius-card); }
	.mobile-nav[open] .mobile-nav__menu { display: none; }
	.mobile-nav[open] .mobile-nav__close { display: block; }

	@media (max-width: 70rem) {
		.desktop-nav__left { gap: 2rem; }
		.availability { display: none; }
	}

	@media (max-width: 56.24rem) {
		.site-header { top: 1rem; right: auto; left: 1.25rem; width: calc(100vw - 2.5rem); transform: translate3d(0, var(--header-translate-y), 0); }
		.desktop-nav { display: none; }
		.mobile-brand-link { display: block; }
		.mobile-nav { display: block; }
	}

	@media (max-width: 47.99rem) {
		.mobile-nav[open] { border: 0; background: var(--color-page); box-shadow: inset 0 0 0 1px var(--color-border); padding: 1rem 1.25rem 1.25rem; }
		.mobile-nav[open] summary { width: 1.875rem; height: 1.875rem; }
		.mobile-nav[open] .mobile-nav__panel { margin-top: 1.25rem; padding: 0; }
		.mobile-nav[open] .mobile-nav__panel li { min-height: 1.25rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.site-header { transition: none; }
		.availability__status::after { animation: none; }
	}
</style>
